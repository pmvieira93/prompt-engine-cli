 func Search(txs []Transaction, query string) []Transaction {
-	return nil // TODO
+	words := strings.Fields(strings.ToLower(query))
+	if len(words) == 0 {
+		return nil
+	}
+	var out []Transaction
+	for _, t := range txs {
+		d, c := strings.ToLower(t.Description), strings.ToLower(t.Category)
