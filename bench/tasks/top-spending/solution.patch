 func TopSpending(txs []Transaction, n int) []CategoryTotal {
-	return nil // TODO
+	spent := map[string]Money{}
+	for _, t := range txs {
+		if t.Amount < 0 {
+			spent[t.Category] -= t.Amount
+		}
+	}
+	var out []CategoryTotal
+	for c, m := range spent {
+		out = append(out, CategoryTotal{c, m})
+	}
+	sort.Slice(out, func(i, j int) bool {
+		if out[i].Spent != out[j].Spent {
+			return out[i].Spent > out[j].Spent
+		}
+		return out[i].Category < out[j].Category
+	})
+	if n <= 0 {
+		return nil
+	}
+	if len(out) > n {
+		out = out[:n]
+	}
+	return out
 }
 
